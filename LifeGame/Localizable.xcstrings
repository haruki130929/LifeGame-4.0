    },
    "不需要和他人比，而是換成和過去的自己比就好" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s no need to compare yourself with others — compare with who you used to be"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他人と比べる必要はありません。過去の自分と比べれば十分です"
