    "養成出現什麼在意的事情時，立刻寫下來的習慣" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the habit of writing down anything that nags at you, the moment it does"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気になることが出てきたら、その場で書き留める習慣をつける"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "養成出現什麼在意的事情時，立刻寫下來的習慣"
          }
        }
      }
    },
    "養成當達到目標八成時，就訂定下一個目標的習慣" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the habit of setting the next goal once you’re eighty per cent of the way"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の8割を達成したら、次の目標を立てる習慣をつける"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "養成當達到目標八成時，就訂定下一個目標的習慣"
          }
        }
      }
    },
    "養成習慣在一天結束時，回顧一整天是否曾脫口說出「沒有錢」、「沒有自信」、「沒有時間」等正當化不行動的藉口" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the habit of reviewing, at day’s end, whether you said things like “no money”, “no confidence”, “no time” — excuses that justify not acting"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日の終わりに、「お金がない」「自信がない」「時間がない」といった、行動しないことを正当化する言い訳を口にしなかったか振り返る習慣をつける"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "養成習慣在一天結束時，回顧一整天是否曾脫口說出「沒有錢」、「沒有自信」、「沒有時間」等正當化不行動的藉口"
          }
        }
      }
    },
    "養成與過去的自己比較的習慣，而非與他人比較" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the habit of comparing with your past self rather than with other people"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他人とではなく、過去の自分と比べる習慣をつける"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "養成與過去的自己比較的習慣，而非與他人比較"
          }
        }
      }
    },
    "首先，在公司或家裡附近找到讓你容易工作的地點" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First, find a spot near the office or home where you find it easy to work"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず、職場や家の近くで作業しやすい場所を見つけましょう"
