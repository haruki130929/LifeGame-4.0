    "長按「＋」後滑動選取功能" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold “+”, then slide to pick a feature"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「＋」を長押しして、滑らせて機能を選ぶ"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按「＋」後滑動選取功能"
          }
        }
      }
    },
    "長按一個時段約 0.3 秒，時段會浮起並震動，這時候就可以拖曳它移動位置。相鄰的時段會自動避讓，放開後時段回到軌道上。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a block for about 0.3 seconds and it lifts with a small vibration — then you can drag it. Neighbouring blocks move out of the way, and it settles back onto the track when you let go."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間帯を約0.3秒長押しすると、浮き上がって振動します。そのままドラッグして移動できます。隣接する時間帯は自動的に避け、指を離すとトラック上に戻ります。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按一個時段約 0.3 秒，時段會浮起並震動，這時候就可以拖曳它移動位置。相鄰的時段會自動避讓，放開後時段回到軌道上。"
          }
        }
      }
    },
    "長按一段再沿圓形拖曳" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a segment, then drag around the circle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区間を長押しして、円に沿ってドラッグ"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按一段再沿圓形拖曳"
          }
        }
      }
    },
    "長按右下角「＋」按鈕，滑動手指選擇功能。在圓環邊緣拖動還可以滾動瀏覽更多選項。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the “+” at the bottom right and slide to pick a feature. Dragging around the ring’s edge scrolls through more options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右下の「＋」を長押しし、指を滑らせて機能を選びます。リングの縁に沿ってドラッグすると、さらに多くの選択肢をスクロールできます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按右下角「＋」按鈕，滑動手指選擇功能。在圓環邊緣拖動還可以滾動瀏覽更多選項。"
          }
        }
      }
    },
    "長按拖曳更直覺" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold and drag, more naturally"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しドラッグがより直感的に"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按拖曳更直覺"
          }
        }
      }
    },
    "長按時段會浮起並震動回饋，拖曳即可移動；放開後自動回到軌道上。時段之間會自動避免重疊。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holding a block lifts it with haptic feedback; drag to move it and it drops back onto the track when released. Blocks avoid overlapping automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間帯を長押しすると浮き上がって触覚フィードバックが返り、ドラッグで移動できます。離すと自動でトラックに戻り、時間帯どうしは重ならないよう調整されます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按時段會浮起並震動回饋，拖曳即可移動；放開後自動回到軌道上。時段之間會自動避免重疊。"
          }
        }
      }
    },
