    },
    "畫面右下角的「＋」FAB 按鈕可以新增時段或進入「課表」設定。課表是獨立的每週範本 — 設好每週固定課程後，系統每天會自動填入內圈。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “+” FAB at the bottom right adds a block or opens Timetable settings. The timetable is a separate weekly template — set your fixed classes and they fill the inner ring automatically each day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面右下の「＋」FAB から時間帯を追加したり、「時間割」の設定を開いたりできます。時間割は独立した週テンプレートで、毎週の固定授業を設定しておくと、毎日自動で内側のリングに反映されます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畫面右下角的「＋」FAB 按鈕可以新增時段或進入「課表」設定。課表是獨立的每週範本 — 設好每週固定課程後，系統每天會自動填入內圈。"
          }
        }
      }
    },
    "當三心二意無法專注時，把在意的事情全寫下來" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you’re torn and can’t focus, write out everything that’s nagging you"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気持ちが定まらず集中できないときは、気になることをすべて書き出す"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當三心二意無法專注時，把在意的事情全寫下來"
          }
        }
      }
    },
    "當事事不順時，就縮小尺規的標準" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When nothing is going right, make the increments on your ruler smaller"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまくいかないときは、ものさしの目盛りを細かくする"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當事事不順時，就縮小尺規的標準"
          }
        }
      }
    },
    "當出現一次失敗或中斷，告訴自己：這是特例，不代表全部。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After one failure or interruption, tell yourself: this is the exception, not the whole picture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の失敗や中断のあとは、自分にこう言いましょう：これは例外で、すべてではない。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當出現一次失敗或中斷，告訴自己：這是特例，不代表全部。"
          }
        }
      }
    },
    "當哪一題" : {
      "extractionState" : "manual",
      "localizations" : {
