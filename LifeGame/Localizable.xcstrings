    "里程碑就是個「路標」，也就是在朝實現目標前進時，路途中掌握大致進度的小目標" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A milestone is a signpost — a small goal that tells you roughly how far along the road to your goal you are"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイルストーンは「道しるべ」です。目標へ向かう途中で、おおよその進み具合をつかむための小さな目標のことです"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "里程碑就是個「路標」，也就是在朝實現目標前進時，路途中掌握大致進度的小目標"
          }
        }
      }
    },
    "重「質」在重「量」：重點在於要先增加「行動量」，接著再提升「行動品質」" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantity before quality: first raise how much you act, then raise how well"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "量より先に質を求めない：まず「行動量」を増やし、次に「行動の質」を高めるのが要点です"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重「質」在重「量」：重點在於要先增加「行動量」，接著再提升「行動品質」"
          }
        }
      }
    },
