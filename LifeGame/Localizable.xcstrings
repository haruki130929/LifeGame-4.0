          }
        }
      }
    },
    "開啟「每小時提醒」，系統會定時提醒你記錄心情。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on the hourly reminder and you’ll be prompted to log your mood regularly."
