    "把「遇到什麼情況」和「當時什麼方法有效」記下來，下次卡住時可以直接翻出來用。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down the situations you run into and what actually helped, so you can look it up next time you get stuck."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「どんな状況だったか」と「そのとき何が効いたか」を書き留めておけば、次に行き詰まったときにすぐ見返せます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把「遇到什麼情況」和「當時什麼方法有效」記下來，下次卡住時可以直接翻出來用。"
          }
        }
      }
    },
    "把一天切成大約五個時段，例如早上、下午、晚上等。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cut the day into roughly five blocks — morning, afternoon, evening and so on."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日をおよそ5つの時間帯に分けましょう。例：朝、午後、夜など。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把一天切成大約五個時段，例如早上、下午、晚上等。"
          }
        }
      }
    },
