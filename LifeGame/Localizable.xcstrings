    "沒有「異想天開的目標」，就沒有辦法累積好不容易做出的行動、努力與付出的辛勞" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without an outlandish goal, the actions, effort and hard work you manage never accumulate into anything"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「突拍子もない目標」がなければ、せっかくの行動や努力、払った苦労が積み上がっていきません"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有「異想天開的目標」，就沒有辦法累積好不容易做出的行動、努力與付出的辛勞"
          }
        }
      }
    },
