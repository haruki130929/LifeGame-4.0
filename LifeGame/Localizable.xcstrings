    "把「可能失敗」變成可以被處理的具體情境，而不是模糊的恐懼。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn “I might fail” into a concrete situation you can handle, rather than a vague fear."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「失敗するかも」を、漠然とした恐れではなく、対処できる具体的な状況に変えましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把「可能失敗」變成可以被處理的具體情境，而不是模糊的恐懼。"
          }
        }
      }
    },
    "把「明天的第一步」寫在便條紙上，放在桌上顯眼的地方。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write tomorrow’s first step on a note and leave it somewhere obvious on your desk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「明日の第一歩」を付箋に書き、机の目立つところに置いておきましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把「明天的第一步」寫在便條紙上，放在桌上顯眼的地方。"
          }
        }
      }
    },
    "把「更新目標」當作成長的證據，而不是不穩定。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treat revising a goal as evidence of growth, not instability."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
