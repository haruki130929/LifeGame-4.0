    "練習承認慾望本身是存在的，而不是馬上評價好或壞。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practise acknowledging that the wanting exists, rather than judging it good or bad straight away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欲求があること自体をまず認める練習をしましょう。すぐに良し悪しを判断せずに。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習承認慾望本身是存在的，而不是馬上評價好或壞。"
          }
        }
      }
    },
    "練習把「今天很糟」改寫成「今天只是比較難」。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practise rewriting “today was terrible” as “today was just harder”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今日はひどかった」を「今日は少し難しかっただけ」と書き換える練習をしましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習把「今天很糟」改寫成「今天只是比較難」。"
          }
        }
      }
    },
    "練習把「運氣好」改寫成「有努力的一部分在裡面」。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
