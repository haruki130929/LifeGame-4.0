    "為了可以展開行動，寫下時間記帳簿讓自己回顧「自己使用時間的方法」" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get yourself moving, keep a time ledger so you can look back at how you actually spend your time"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動できるようにするために、時間の家計簿をつけて「自分の時間の使い方」を振り返りましょう"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了可以展開行動，寫下時間記帳簿讓自己回顧「自己使用時間的方法」"
          }
        }
      }
    },
    "為了可以確實展開行動，請具體決定好「何時、在哪裡、做什麼」" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To make sure you actually act, decide concretely when, where and what"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確実に行動するために、「いつ・どこで・何を」を具体的に決めましょう"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了可以確實展開行動，請具體決定好「何時、在哪裡、做什麼」"
          }
        }
      }
    },
    "為了讓「心裡的聲音」外顯出來，就需要與自己對話，具體來說，就是問自己「其實想要怎麼做？」" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bring the voice of your heart to the surface you have to talk to yourself — concretely, ask: what do I actually want to do?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「心の声」を表に出すには、自分との対話が必要です。具体的には「本当はどうしたいのか？」と自分に問いかけます"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了讓「心裡的聲音」外顯出來，就需要與自己對話，具體來說，就是問自己「其實想要怎麼做？」"
          }
        }
      }
    },
    "為任務設定「自己的期限」，比正式截止日提前幾天。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the task your own deadline, a few days before the official one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクに「自分の期限」を設けましょう。正式な締切より数日早めに。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為任務設定「自己的期限」，比正式截止日提前幾天。"
          }
        }
      }
    },
    "為每一個時段設定「主題」，而不是一堆零散待辦。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give each block a theme, instead of a scatter of odd to-dos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間帯ごとに「テーマ」を決めましょう。ばらばらのタスクを並べるのではなく。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每一個時段設定「主題」，而不是一堆零散待辦。"
          }
        }
      }
    },
    "為每個里程碑寫下一句：「達到時代表什麼」。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write one line per milestone: what reaching it will mean."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイルストーンごとに一行書きましょう：「到達したら何を意味するか」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個里程碑寫下一句：「達到時代表什麼」。"
          }
        }
      }
    },
    "為自己設計小獎勵：完成一個區塊就可以休息或做喜歡的事。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Design small rewards: finish a block and you get a rest or something you enjoy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さなご褒美を用意しましょう：一区切り終えたら休憩、または好きなことを。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為自己設計小獎勵：完成一個區塊就可以休息或做喜歡的事。"
          }
        }
      }
