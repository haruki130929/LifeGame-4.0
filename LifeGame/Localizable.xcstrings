    },
    "「比馬龍效應」：當人受到稱讚時或備受矚目時，就有做出眾所期待成果的傾向" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Pygmalion effect”: when people are praised or paid attention to, they tend to deliver the results expected of them"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ピグマリオン効果」：人は褒められたり注目されたりすると、期待どおりの成果を出す傾向があります"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「比馬龍效應」：當人受到稱讚時或備受矚目時，就有做出眾所期待成果的傾向"
          }
        }
      }
    },
    "「激勵因素」：與滿足感、成就感和幸福感相關的因素" : {
