    "用 15 分鐘計時器，只在這 15 分鐘專心做一件小事。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a fifteen-minute timer and give those fifteen minutes to one small thing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15分のタイマーをかけ、その15分だけ小さなこと一つに集中しましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 15 分鐘計時器，只在這 15 分鐘專心做一件小事。"
          }
        }
      }
    },
    "用什麼方式穩定下來（可複選）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you settled down (select all)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち着かせた方法（複数選択可）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用什麼方式穩定下來（可複選）"
          }
        }
      }
    },
    "用寬廣的視野檢視自己整體表現稱為「俯瞰」，只要培養出這種俯瞰的視角，情緒就不會因眼前的結果或成果過度起伏，而能逐步累積自己的行動" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking at your performance as a whole is called taking the wider view. Build that perspective and your feelings stop swinging with each immediate result, letting your actions accumulate steadily."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の全体像を広い視野で見ることを「俯瞰」といいます。この視点が育つと、目先の結果や成果で感情が過度に揺れなくなり、行動を着実に積み上げられます"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用寬廣的視野檢視自己整體表現稱為「俯瞰」，只要培養出這種俯瞰的視角，情緒就不會因眼前的結果或成果過度起伏，而能逐步累積自己的行動"
          }
        }
      }
    },
    "用簡單方式記錄今天每半小時在做什麼，不需要太細。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note roughly what you did each half hour today — no need for detail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日30分ごとに何をしていたかを簡単に記録しましょう。細かくなくて大丈夫です。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡單方式記錄今天每半小時在做什麼，不需要太細。"
          }
        }
      }
    },
    "用紀錄方式觀察：哪一種對自己最有效。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep notes and watch which one works best for you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録をつけて、どれが自分に最も効くか観察しましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用紀錄方式觀察：哪一種對自己最有效。"
          }
        }
      }
    },
    "用舊習慣綁新習慣" : {
