    "避免在「休息用的位置」做工作，讓大腦更容易分辨模式。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t work where you rest — it helps your brain tell the modes apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「休むための場所」で作業しないようにすると、脳がモードを区別しやすくなります。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免在「休息用的位置」做工作，讓大腦更容易分辨模式。"
          }
        }
      }
    },
    "避免寫超過三件，如果有第四件就放到「備選」。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t write more than three; a fourth goes on the “maybe” list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つを超えて書かないようにし、4つ目は「候補」に回しましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免寫超過三件，如果有第四件就放到「備選」。"
          }
        }
      }
    },
    "避免把行程塞滿，保留空白時間讓身體恢復。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t pack the schedule solid — leave blank time for your body to recover."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定を詰め込みすぎず、体が回復する空白の時間を残しましょう。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免把行程塞滿，保留空白時間讓身體恢復。"
          }
        }
      }
    },
    "還可以附加照片，記錄生活中的重要時刻。" : {
