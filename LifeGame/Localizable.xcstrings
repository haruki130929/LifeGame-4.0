    },
    "開啟 iCloud 同步後，資料會自動在你登入同一個 Apple ID 的所有裝置間同步，不需要額外登入。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With iCloud sync on, your data syncs across every device signed in to the same Apple ID — no extra sign-in needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同期をオンにすると、同じ Apple ID でサインインしたすべての端末間でデータが自動的に同期されます。追加のサインインは不要です。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
